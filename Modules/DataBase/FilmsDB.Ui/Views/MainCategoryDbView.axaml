<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mvvm="http://prismlibrary.com/"
             xmlns:styles="clr-namespace:Material.Styles;assembly=Material.Styles"
             xmlns:assists="clr-namespace:Material.Styles.Assists;assembly=Material.Styles"
             xmlns:controls="clr-namespace:Material.Styles.Controls;assembly=Material.Styles"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:views="clr-namespace:FilmsDB.Ui.Views"
             x:Class="FilmsDB.Ui.Views.MainCategoryDbView"
             mc:Ignorable="d"
             mvvm:ViewModelLocator.AutoWireViewModel="True"
             x:Name="MainTopicDbControl"
             x:DataType="views:MainCategoryDbViewModel"
             d:DesignWidth="800" d:DesignHeight="450">

    <Design.DataContext>
        <views:MainCategoryDbViewModel />
    </Design.DataContext>

    <TabControl>
        <TabControl.Items>

            <TabItem Header="Категории">
                <views:CategoryListPage />
            </TabItem>

            <TabItem Header="Фильмы">
                <views:FilmDataGridPage />
            </TabItem>

        </TabControl.Items>
    </TabControl>

</UserControl>